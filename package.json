{
  "name": "command-center",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "blender:validate": "python3 blender/validate_scene.py blender/scenes/starter-office.json apps/web/public/models",
    "blender:assets": "bash scripts/generate-blender-assets.sh",
    "blender:test": "bash scripts/test-blender-importer.sh",
    "blender:render": "bash scripts/render-blender.sh",
    "city:assets": "bash scripts/generate-engineering-city-assets.sh",
    "city:assets:validate": "pnpm --filter @command-center/web city:assets:validate"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "postcss": "^8.5.16",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.2",
    "turbo": "^2.3.3"
  }
}
